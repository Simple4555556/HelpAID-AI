# Database Configurations
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/helpaid?retryWrites=true&w=majority

# Server Configurations
PORT=5000

# Google Gemini API Key (Free Tier)
GEMINI_API_KEY=your_gemini_api_key_here
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Free Tier Configurations
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_firebase_auth_domain
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket
VITE_FIREBASE_MESSAGING_SENDER_ID=your_firebase_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_FIRESTORE_DATABASE_ID=your_firebase_firestore_database_id

# Deployed Backend Endpoint Routing
VITE_API_URL=https://your-backend-subdomain.onrender.com
